#!/usr/bin/env libui
#####
#
# test_FormatElapsed
#
#####

test_FormatElapsed () {
  LibuiGetDisplayTestValues
  LoadMod Timer
  if ${ZSH}
  then
    ELAPSED=90061.5
    FormatElapsed
    LibuiPerformTest 'Tell "Formatted zsh: %s" "${ELAPSED}"'
    LibuiValidateTest ${?} 0 'Formatted zsh: 25:01:01.5000'
  else
    ELAPSED=90061
    FormatElapsed
    LibuiPerformTest 'Tell "Formatted bash: %s" "${ELAPSED}"'
    LibuiValidateTest ${?} 0 'Formatted bash: 25:01:01'
  fi
  return ${?}
}

# test setup
_Test_opt+='-x P '

return 0
