#!/usr/bin/env libui
#####
#
# test_libui_package
#
#####

test_libui_package () {
  GetTmp tl
  libui -p "${tl}/pkg"
  mkdir "${tl}/ti"
  ls -al "${tl}"
  ${SHENV} "${tl}/pkg.tarp" -XF -i "${tl}/ti"
  LibuiPerformTest 'diff <(cd "${LIBUI%/*/*/*}" && find . -name ".DS_Store" -prune -o -name ".gitignore" -prune -o -path "./.git" -prune -o -name "Makefile" -prune -o -path "./lib/test/libui" -prune -o -type f -print | LC_ALL=C sort) <(cd "${tl}/ti" && find . -type f -print | LC_ALL=C sort) | grep "\(<\|>\)" | LC_ALL=C sort'
  LibuiValidateTest ${?} 0
  return ${?}
}

return 0
