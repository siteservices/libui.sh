#!/usr/bin/env libui
#####
#
# test_libui-p
#
#####

test_libui-p () {
  GetTmp tl
  libui -p "${tl}/pkg"
  pushd "${tl}" 2> /dev/null
  ${SHENV} "pkg.tarp" -e
  popd 2> /dev/null
  pushd "${LIBUI%/*/*/*}" 2> /dev/null
  LibuiPerformTest 'diff <(find . -name ".DS_Store" -prune -o -name ".gitignore" -prune -o -path "./.git" -prune -o -name "Makefile" -prune -o -type f -print | LC_ALL=C sort) <(tar tf "${tl}/pkg.tarp.tar" | LC_ALL=C sort) | grep "\(<\|>\)" | LC_ALL=C sort'
  local tv=${?}
  popd 2> /dev/null
  LibuiValidateTest ${?} 0
  return ${?}
}

return 0
