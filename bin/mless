##### libui setup

# script version
Version -r 2.018 1.11

# load mods
LoadMod File

##### configuration

# defaults
MLESSPATH="${MLESSPATH:+${MLESSPATH}:}${COMMONROOT:+${COMMONROOT}/share/doc:}${HOME}/.local/env/share/doc:${LIBUI%/*/*/*}/share/doc"
${ZSH} && docpath=( "${(@s[:])MLESSPATH}" ) || IFS=: docpath=( ${MLESSPATH} )
${UTF8} && bulleticon=$'\u2022' || bulleticon='o '
${UTF8} && bottomcorner=$'\u2514' || bottomcorner='|'
${UTF8} && topcorner=$'\u250C' || topcorner='|'
${UTF8} && horizontal=$'\u2500' || horizontal='-'
${UTF8} && vertical=$'\u2502' || vertical='|'
width=${COLUMNS:-80}
rule=; for i in {1..$((width - 1))}; do rule+="${horizontal}"; done
top="${topcorner}"; for i in {1..$((width - 3))}; do top+="${horizontal}"; done
bottom="${bottomcorner}"; for i in {1..$((width - 3))}; do bottom+="${horizontal}"; done
heading1="${Db}${Dsi}${Dsu}${DFm}"
heading2="${Db}${Dsi}${Dsu}${DFy}"
heading3="${Db}${Dsi}${Dsu}${DFg}"
heading4="${Db}${Dsi}${Dsu}${DFc}"
heading5="${Db}${Dsi}${Dsu}${DFb}"
heading6="${Db}${Dsi}${Dsu}${DFr}"
blockquote="${DFm}"
bullet="${DFm}"
code="${Db}${DFb}"
codebox="${Dd}${Dfc}"
image="${Dfc}"
link="${DFb}"
strong="${Db}"
emphasis="${Dsi:-${Dsu}}"
strikethrough="${Dd}${Dsx}"

##### options - libui already uses options h, H, X:

AddOption -n nopaging -f -k 'No Paging' -d 'Do not page.' P
AddParameter -n files -m -k 'File' -d 'File to view.'

##### callbacks

InfoCallback () {
  Trace 'Usage info.'
  cat << EOF
The mless script provides basic interpretation of markdown in a terminal
environment using ${PAGER}. Due to the limited terminal environment, mless has
limited capabilities including:

  - Basic support for headers (up to 4 levels)
  - Support for emphasis and underlined text
  - Support for unordered lists
  - Basic support for ordered lists (up to 3 digits)
  - Basic support for block indents (up to 4 levels)
  - Basic support for backslash (\\) escapes
  - Removing (without supporting) HTML tags
  - Removing doubled blank lines

Note: Expects the \${PAGER} variable to be set to an application that supports
terminal codes (for colors). The default is "less".
EOF
}

InitCallback () {
  Trace 'In user init callback.'

  Trace 'Check for files. (%s)' "${files[*]}"
  if [[ -n "${files[@]}" ]]
  then
    local dir
    local found
    local md
    local mdfiles
    GetFileList mdfiles "${files}"
    if [[ -z "${mdfiles}" ]]
    then
      GetFileList mdfiles "${files[@]/%/.md}"
      if [[ -z "${mdfiles}" ]]
      then
        for file in "${files[@]}"
        do
          for dir in "${docpath[@]}"
          do
            GetFileList found "${file/#/${dir%/}/}"
            [[ -n "${found}" ]] && mdfiles+=( "${found[@]}" ) && break
            md=( "${file/%/.md}" )
            GetFileList found "${md[@]/#/${dir%/}/}"
            [[ -n "${found}" ]] && mdfiles+=( "${found[@]}" ) && break
          done
        done
      fi
    fi
    [[ -n "${mdfiles[@]}" ]] && files=( "${mdfiles[@]}" ) || Error 'File not found.'
  else
    files=( '/dev/stdin' )
  fi

  Trace 'Check for no paging. (%s)' "${nopaging}"
  ${nopaging} && PAGER=cat
}

##### functions

pager () {
  if [[ "${PAGER}" == 'less' && $(less -V 2> /dev/null | head -n 1 | cut -f 2 -d ' ') -gt 632 ]]
  then
    ${PAGER} --wordwrap
  else
    awk "function len(s) { gsub(/\x1b[\[\(][0-9;]*[a-zA-Z]/, \"\", s); return length(s) }
    BEGIN { cols = ${width} - 1; line = \"\" }
    {
      if (/^([[:space:]]|$)/) {
        if (len(line) > 0) { print line }
        if (/^[[:space:]]*$/) { printf \"\n\"; line = \"\"; space = \"\" } else { line = \$0 }
      } else {
        for (i = 1; i <= NF; i++) {
          if (len(line) + len(\$i) > cols) { print line; line = \$i } else { line = ( line space \$i ); space = \" \" }
        }
      }
    }
    END { if ( len(line) > 0 ) printf \"%s\", line } END {print \"\"}" | ${PAGER:-less}
  fi
}

##### initialization

# initialize UI
Initialize


#####
#
# main program
#
#####

Trace 'Start %s. (%s)' "${CMD}" "${CMDLINE}"

Trace 'Loop through files. (%s)' "${files[*]}"
for file in "${files[@]}"
do
  Trace 'Display file. (%s)' "${file}"
  cat "${file}" | \
      awk "/^\`\`\`[a-zA-Z]*\$/ {
        if (code == 0) {
          print \"  ${codebox}${top}${D}\"; print \"  ${codebox}${vertical}${D}\"; print; code = 1
        } else {
          print; print \"  ${codebox}${vertical}${D}\"; print \"  ${codebox}${bottom}${D}\"; code = 0
        } next
      } !code {
        FS=\"\`\"; OFS=\"\`\";
        if (NF >= 2) for (i=2; i < NF; i += 2) {
          gsub(/\\\\/, \"\x01\", \$i)
          gsub(/_/, \"\\\\_\", \$i)
          gsub(/</, \"\\\\<\", \$i)
          gsub(/>/, \"\\\\>\", \$i)
          gsub(/\\*/, \"\\\\*\", \$i)
        }
      } 1" | \
      sed -E \
        -e '/^```[a-zA-Z]*$/,/^```$/!{' \
          -e "s/\[([^]]*)\](\([^)]*\))/ ${link}-> ${Dsu}\1${D}/g" \
          -e "s/!\[([^]]*)\](\([^)]*\))/ ${image}-> ${Dsi}\1${D}/g" \
          -e "s/^[[:space:]]{0,3}[*_-][[:space:]]*[*_-][[:space:]]*[*_-][[:space:]]*[*_-]*[[:space:]]*$/${rule}/" \
          -e "s/^([[:space:]]*)[*+-][[:space:]]/\1  ${bullet}${bulleticon}${D} /" \
          -e "s/^#######+[[:space:]](.*)$/${heading6}\1${D}\n/" \
          -e "s/^######[[:space:]](.*)$/${heading5}\1${D}\n/" \
          -e "s/^#####[[:space:]](.*)$/${heading4}\1${D}\n/" \
          -e "s/^###[[:space:]](.*)$/${heading3}\1${D}\n/" \
          -e "s/^##[[:space:]](.*)$/${heading2}\1${D}\n/" \
          -e "s/^#[[:space:]](.*)$/${heading1}\1${D}\n/" \
          -e "s/(^|[^\\])\*\*\*([^*]+)\*\*\*/\1${strong}${emphasis}\2${D}/g" \
          -e "s/(^|[^\\])\*\*([^*]+)\*\*/\1${strong}\2${D}/g" \
          -e "s/(^|[^\\])\*([^*]+)\*/\1${emphasis}\2${D}/g" \
          -e "s/(^|[^\\])___([^_]+)___/\1${strong}${emphasis}\2${D}/g" \
          -e "s/(^|[^\\])__([^_]+)__/\1${strong}\2${D}/g" \
          -e "s/(^|[^\\])_([^_]+)_/\1${emphasis}\2${D}/g" \
          -e "s/(^|[^\\])~~([^~]+)~~/\1${strikethrough}\2${D}/g" \
          -e 's/`\\`/`\\\\`/g' \
          -e 's/^(.*`[^`]*[^\\])<([^>]*[^\\])>([^`]*`.*)$/\1\\\<\2\\\>\3/g' \
          -e "s/(^|[^\`])\`([^\`]+)\`/\1${code}\2${D}/g" \
          -e 's/(^|[^\\])<[^>]*[^\\]>/\1/g' \
          -e "s/^>>>>[[:space:]]/${blockquote} ${vertical} ${vertical} ${vertical} ${vertical}${D}  /" \
          -e "s/^>>>[[:space:]]/${blockquote} ${vertical} ${vertical} ${vertical}${D}  /" \
          -e "s/^>>[[:space:]]/${blockquote} ${vertical} ${vertical}${D}  /" \
          -e "s/^>[[:space:]]/${blockquote} ${vertical}${D}  /" \
          -e 's/([^\\])\\([^\\])/\1\2/g' \
          -e 's/\\\\//g' \
        -e '}' | \
      sed '/^$/N;/^\n$/D' | \
      sed -E \
        -e '/^```[a-zA-Z]*$/,/^```$/{' \
          -e '/^```/d' \
          -e "s/^/  ${codebox}${vertical}${D}  ${code}/" \
          -e 's/\\/\\\\/g' \
          -e "s/$/${D}/" \
        -e '}' \
        -e 's/\\([^\\])/\1/g' \
        -e 's/\x01/\\/g' \
        -e '/^[[:space:]]*[0-9]{1,9}[.)]/,/^[[:space:]]*$/{ s/^([[:space:]]*)([0-9]{1,9})([.)])(.*)$/\1  .\2\3  \4/; }' | \
      awk 'BEGIN { i = 1 } /^[[:space:]]*\.[0-9]{1,9}[\.\)]/ { if (sub(/\.[0-9]{1,9}/, i++, $0)) print $0; next } { i = 1; print }' | \
      pager
          #-e 's/([^\\])\\\([^\\])/\1\\\\\\\\\2/g' \
done

Trace 'Exit %s. (%s)' "${CMD}" "${RETVAL}"
Exit
